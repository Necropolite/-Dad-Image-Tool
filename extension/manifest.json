{
  "manifest_version": 3,
  "name": "Dad Image Tool Link Helper",
  "version": "0.3.0",
  "description": "Open shared picture links in Dad Image Tool or the browser.",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "options_page": "options.html"
}
